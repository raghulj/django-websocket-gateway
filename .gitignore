# ─── Go ─────────────────────────────────────────────────────────────────
# Local build outputs
gateway/gateway
gateway/dist/
*.exe
*.exe~
*.dll
*.test
*.out
gateway/bin/

# Optional: vendor is checked in by some projects, ignore by default
gateway/vendor/

# ─── Downloaded gateway binary cache ────────────────────────────────────
# The Python package downloads the Go binary into websocket_gateway/bin/
# at runtime; only the .gitkeep should be tracked.
websocket_gateway/bin/*
!websocket_gateway/bin/.gitkeep

# ─── MkDocs / docs ──────────────────────────────────────────────────────
site/
_site/
docs/site/
.cache/

