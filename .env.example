# django-websocket-gateway — example environment file.
#
# Copy to `.env` and replace every value. The pre-commit hook will refuse
# to commit `.env`, but you can still leak secrets by pasting them into
# chat or logs — be careful.

# Public domain Caddy serves. Used in TLS, and for ALLOWED_ORIGINS.
DOMAIN=app.example.com

# Comma-separated list of allowed WebSocket Origin headers.
# Browsers only send Origin for cross-origin requests; same-origin
# upgrades arrive with empty Origin (handled by the gateway).
ALLOWED_ORIGINS=https://app.example.com

# Django's signing secret. Do NOT reuse this for WS_INTERNAL_SECRET.
DJANGO_SECRET_KEY=CHANGEME_GENERATE_WITH_python_-c_secrets_token_urlsafe_64

# Dedicated shared secret for Django <-> gateway. Must be ≥32 chars and
# distinct from DJANGO_SECRET_KEY. The settings validator enforces both.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WS_INTERNAL_SECRET=CHANGEME_GENERATE_WITH_python_-c_secrets_token_urlsafe_48

# Optional: override the default DATABASE_URL. SQLite for examples.
# DATABASE_URL=postgres://django:django@db:5432/django
